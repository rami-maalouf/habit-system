{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "RIPPLES_CLOUDKIT_ENVIRONMENT": "Development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "RIPPLES_CLOUDKIT_ENVIRONMENT": "Development"
      }
    },
    "sim": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "RIPPLES_CLOUDKIT_ENVIRONMENT": "Production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
